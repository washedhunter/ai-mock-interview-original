# Copy to .env (gitignored) and fill in. Every setting is optional.

# Gemini (Google AI Studio -> Get API key). Without it the app runs in a labelled demo mode
# with canned questions and feedback (transcription and delivery metrics stay real).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Speech-to-text: local = faster-whisper in the backend container (default),
# groq = Whisper large-v3-turbo on Groq's API (needs GROQ_API_KEY), mock = canned transcript.
TRANSCRIBER=local
# faster-whisper model for TRANSCRIBER=local: tiny.en, base.en (default), small.en, ...
# Changing it rebuilds the backend image with that model baked in.
WHISPER_MODEL=base.en
GROQ_API_KEY=

# Keep raw audio after transcription (default false: deleted straight away).
KEEP_AUDIO=false

# Rate limits (per user per hour).
RATE_INTERVIEWS_PER_HOUR=10
RATE_ANSWERS_PER_HOUR=60

# Local ports / passwords for docker compose.
FRONTEND_PORT=3000
POSTGRES_PASSWORD=interview

# Set true when served over HTTPS (production).
COOKIE_SECURE=false
